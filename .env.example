# Copy this file to `.env` and update values for your environment.
# Do NOT commit your real credentials to a public repository.

# MySQL database name
MYSQL_DATABASE=parqueadero_db

# MySQL user and password for the application
MYSQL_USER=Kevinfelipe
MYSQL_PASSWORD=changeme

# MySQL root password (used only for container initialization)
MYSQL_ROOT_PASSWORD=changeme_root

# Optional: override Spring Boot server port (default 8081)
SERVER_PORT=8081
